---
import Layout from "../layouts/Layout.astro";
import {
  deriveScene,
  sceneStyle,
  SCATTER_MARKS,
  SPECTRUM_BANDS,
  PACKETS,
  INITIAL_ELEVATION,
  MIN_ELEVATION,
  MAX_ELEVATION,
} from "../scripts/main";

const scene = deriveScene(INITIAL_ELEVATION);
const sceneStyleAttr = sceneStyle(scene);
const AIR_BANDS = [0, 1, 2, 3];
const PORTAL_PARTICLES = Array.from({ length: 24 }, (_unused, index) => {
  const angle = (index / 24) * Math.PI * 2 + (index % 3) * 0.08;
  const distance = 30 + (index % 6) * 8;
  return {
    x: (Math.cos(angle) * distance).toFixed(2),
    y: (Math.sin(angle) * distance).toFixed(2),
    rotation: index * 47,
    delay: (index % 8) * 18,
    size: 3 + (index % 4) * 2,
  };
});
---

<Layout title="The Sun Never Turned Red">
  <!--
    The stage is the whole viewport-scale experience and carries the canonical
    elevation state as CSS custom properties, which inherit down into every
    part of the illustration. It is deliberately not role="img": it contains
    the range control, and image semantics would bury it. The visual
    description lives on the atmosphere field instead.
  -->
  <main
    class="stage"
    data-testid="scene"
    aria-label="The Sun Never Turned Red: an interactive atmospheric explainer"
    style={sceneStyleAttr}
  >
    <div
      class="atmosphere"
      data-testid="atmosphere"
      role="img"
      aria-label="A diagram of sunlight travelling to a collecting aperture on the ground. Lowering the Sun flattens the route so it crosses more shells of air; short-wavelength packets are turned aside out of the beam and spread across the sky, and the packets still arriving are the longer, warmer ones. Raising the Sun shortens and steepens the route, so less is turned aside and the arriving light stays pale. A spectrum labelled what reached the aperture reads out band by band, and the written explanation describes the current setting."
    >
      <!-- Shells of air. The shallow route crosses more of them, which is what
           makes the longer low-Sun path legible rather than merely stated. -->
      <div class="air-shells" aria-hidden="true">
        {AIR_BANDS.map((i) => <span class="air-shell" style={`--shell:${i};`} />)}
      </div>

      <div class="haze"></div>

      <!-- Everything geometric hangs off the observer and is rotated by the one
           derived beam angle, so the route, the crossing, the packets and the
           Sun can never drift out of alignment. -->
      <div class="beam-anchor">
        <div class="beam-frame">
          <div class="beam-soft" data-testid="direct-beam"></div>
          <div class="beam-core"></div>

          <div class="atmos-path" data-testid="atmospheric-path">
            <div class="scattering" data-testid="scattering-layer">
              {
                SCATTER_MARKS.map((mark) => (
                  <span
                    class="scatter-mark"
                    data-testid="scatter-mark"
                    style={`--along:${mark.along};--side:${mark.side};--reach:${mark.reach.toFixed(3)};--tilt:${mark.tilt.toFixed(2)}deg;`}
                  />
                ))
              }
            </div>

            <!-- The packets are the hero: short-wavelength ones peel out of the
                 beam, long-wavelength ones carry on to the eye. -->
            <div class="packets">
              {
                PACKETS.map((packet, i) => (
                  <span
                    class="packet"
                    data-testid="packet"
                    data-scatters={String(SPECTRUM_BANDS[packet.band].scatters)}
                    data-band={SPECTRUM_BANDS[packet.band].label}
                    style={`--along:${packet.along.toFixed(4)};--side:${packet.side};--reach:${packet.reach.toFixed(3)};--delay:${packet.delay.toFixed(3)};--tint:${SPECTRUM_BANDS[packet.band].tint};--band-t:var(--band-${packet.band});--i:${i};`}
                  />
                ))
              }
            </div>
          </div>

          <div class="transmitted" data-testid="transmitted-beam"></div>

          <div class="sun-bloom"></div>
          <div class="sun-disc"></div>
        </div>
      </div>

      <div class="horizon"></div>

      <!-- The receiver: a graduated aperture, so the destination reads as an
           instrument collecting light rather than a face looking at it. The
           core brightens with whatever survived the crossing. -->
      <button
        class="receiver trace-aperture"
        data-testid="trace-aperture"
        type="button"
        aria-label="Open the observer's session trace"
        aria-controls="footprint-coda"
        aria-expanded="false"
      >
        <span class="receiver-rim" aria-hidden="true"></span>
        <span class="receiver-iris" aria-hidden="true"></span>
        <span class="receiver-core" aria-hidden="true"></span>
        <span class="receiver-hint" aria-hidden="true">observe the observer</span>
      </button>

      <div class="portal-field" aria-hidden="true">
        {
          PORTAL_PARTICLES.map((particle) => (
            <span
              class="portal-particle"
              data-testid="portal-particle"
              aria-hidden="true"
              style={
                "--tx:" +
                particle.x +
                "vw;--ty:" +
                particle.y +
                "vh;--rot:" +
                particle.rotation +
                "deg;--delay:" +
                particle.delay +
                "ms;--size:" +
                particle.size +
                "px;"
              }
            />
          ))
        }
      </div>

      <div class="received-colour" data-testid="received-colour">
        <span class="received-swatch" aria-hidden="true"></span>
        <span>
          <small>light that survived</small>
          <strong>spectrum-derived colour</strong>
        </span>
      </div>

      <aside class="model-strip" data-testid="airmass-model" aria-label="The three-step light model">
        <p class="model-kicker">One slider · one causal model</p>
        <ol>
          <li>
            <span class="model-number">01</span>
            <strong>Air mass <output data-testid="airmass-value">×{scene.pathAmount.toFixed(1)}</output></strong>
            <code>m(h) = 1 / (sin h + correction)</code>
            <small>Low angles cross more atmosphere.</small>
          </li>
          <li>
            <span class="model-number">02</span>
            <strong>Fourth power</strong>
            <code>scatter ∝ 1 / λ⁴</code>
            <small>Short blue wavelengths turn aside fastest.</small>
          </li>
          <li>
            <span class="model-number">03</span>
            <strong>What survives</strong>
            <code>T(λ) = e<sup>−τm/λ⁴</sup></code>
            <small>The direct beam becomes dimmer and warmer.</small>
          </li>
        </ol>
      </aside>

      <!-- Two labels, both in atmosphere space and anchored to the receiver.
           Keeping them out of the rotated beam frame means no counter-rotation,
           and so no chance of the box swinging off-screen at steep angles. -->
      <p class="scene-label scene-label-scatter">blue redirected</p>
      <p class="scene-label scene-label-direct">received</p>
    </div>

    <header class="overlay">
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
      <h1>The Sun Never Turned Red</h1>
      <p class="instruction" data-testid="instruction">
        Move the Sun toward the horizon.
      </p>
    </header>

    <div class="rail" data-testid="rail">
      <div class="rail-control">
        <label for="elevation">Sun elevation</label>
        <span class="rail-end" aria-hidden="true">horizon</span>
        <input
          type="range"
          id="elevation"
          name="elevation"
          min={MIN_ELEVATION}
          max={MAX_ELEVATION}
          step="1"
          value={INITIAL_ELEVATION}
        />
        <span class="rail-end" aria-hidden="true">overhead</span>
        <span class="rail-value" data-testid="value-readout" aria-hidden="true">
          {Math.round(scene.elevationDeg)}°
        </span>
      </div>

      <!-- Deliberately a sibling of the atmosphere, not a child: on desktop it
           is positioned into the sky's empty right-hand field, but staying
           outside the role="img" region keeps every band name readable by
           assistive technology. -->
      <figure class="arrival" data-testid="arrival-spectrum">
        <figcaption class="arrival-caption">What reached the aperture</figcaption>
        <div class="arrival-ribbon">
          {
            SPECTRUM_BANDS.map((band, i) => (
              <span
                class="arrival-band"
                data-testid="spectrum-band"
                data-band={band.label}
                style={`--i:${i};--tint:${band.tint};--band-t:var(--band-${i});`}
              >
                <span class="arrival-band-fill"></span>
                <span class="visually-hidden">{band.label}</span>
              </span>
            ))
          }
        </div>
        <div class="arrival-scale">
          <span>blue — redirected</span>
          <span>red — gets through</span>
        </div>
      </figure>

      <output class="rail-output" for="elevation" id="explanation" aria-live="off"
        >{scene.explanation}</output
      >

      <p class="rail-note" data-testid="model-note">
        Simplified illustration — not a physical simulation.
      </p>
    </div>
    <section
      class="footprint-coda"
      data-testid="footprint-coda"
      id="footprint-coda"
      aria-labelledby="footprint-title"
      aria-hidden="true"
      hidden
    >
      <div class="coda-grid" aria-hidden="true"></div>
      <div class="coda-shell">
        <header class="coda-header">
          <p class="coda-wordmark">OBSERVER / LOCAL TRACE</p>
          <p class="coda-local">this session · memory only</p>
        </header>

        <div class="coda-intro">
          <p class="coda-index">A second observation</p>
          <h2 id="footprint-title" tabindex="-1">The page had an observer, too.</h2>
          <p class="coda-lede">
            You watched the atmosphere turn light into signals. Meanwhile, the page
            turned this visit into signals — without asking for a sensitive permission.
          </p>
          <p class="coda-boundary">
            This session only. Nothing is saved. Nothing is sent. Reloading erases it.
          </p>
        </div>

        <div class="trace-deck" aria-live="polite">
          <article class="trace-card" data-testid="trace-card" data-trace-card="0">
            <p class="trace-card-number">01 / TIME</p>
            <h3>A visit became a timeline.</h3>
            <p class="trace-hero" data-trace="elapsed">0 seconds</p>
            <p class="trace-copy">
              The page can measure how long this tab has been open without knowing your name.
            </p>
            <p class="trace-micro">
              <span data-trace="resizes">0</span> resizes ·
              <span data-trace="visibility">0</span> tab visibility changes
            </p>
          </article>

          <article class="trace-card" data-testid="trace-card" data-trace-card="1" hidden>
            <p class="trace-card-number">02 / GESTURE</p>
            <h3>One slider became behaviour.</h3>
            <p class="trace-hero"><span data-trace="moves">0</span> state changes</p>
            <dl class="trace-facts">
              <div><dt>range explored</dt><dd data-trace="range">45° → 45°</dd></div>
              <div><dt>input modes</dt><dd data-trace="modes">none yet</dd></div>
            </dl>
          </article>

          <article class="trace-card" data-testid="trace-card" data-trace-card="2" hidden>
            <p class="trace-card-number">03 / ENVIRONMENT</p>
            <h3>Your browser spoke before you typed.</h3>
            <dl class="trace-facts trace-facts-wide">
              <div><dt>viewport</dt><dd data-trace="viewport">—</dd></div>
              <div><dt>pixel ratio</dt><dd data-trace="pixels">—</dd></div>
              <div><dt>language</dt><dd data-trace="language">—</dd></div>
              <div><dt>time zone</dt><dd data-trace="timezone">—</dd></div>
              <div><dt>display preference</dt><dd data-trace="display">—</dd></div>
            </dl>
          </article>

          <article class="trace-card trace-card-zero" data-testid="trace-card" data-trace-card="3" hidden>
            <p class="trace-card-number">04 / BOUNDARY</p>
            <h3>What this prototype refused to collect.</h3>
            <div class="zero-grid">
              <p><strong>0</strong><span>permission prompts</span></p>
              <p><strong>0</strong><span>trace uploads</span></p>
              <p><strong>0</strong><span>saved records</span></p>
            </div>
            <p class="trace-copy">
              No camera, microphone, location, cookies, analytics, or persistent fingerprint.
            </p>
          </article>

          <nav class="trace-nav" aria-label="Session trace slides">
            <button type="button" data-trace-previous>Previous signal</button>
            <output data-trace="progress" aria-live="off">1 / 4</output>
            <button type="button" data-trace-next>Next signal</button>
          </nav>
        </div>

        <footer class="coda-footer">
          <button class="coda-return" type="button" data-trace-return>Return to the light</button>
          <button class="coda-erase" type="button" data-trace-erase>Erase this trace</button>
        </footer>
      </div>
    </section>
  </main>
  <script src="../scripts/main.ts"></script>
  <script src="../scripts/footprint.ts"></script>
</Layout>
