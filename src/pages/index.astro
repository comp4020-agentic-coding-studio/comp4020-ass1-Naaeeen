---
import Layout from "../layouts/Layout.astro";
import {
  deriveScene,
  sceneStyle,
  INITIAL_ELEVATION,
  MIN_ELEVATION,
  MAX_ELEVATION,
} from "../scripts/main";

const scene = deriveScene(INITIAL_ELEVATION);
const sceneStyleAttr = sceneStyle(scene);
---

<Layout title="The Sun Never Turned Red">
  <!--
    The stage is the whole viewport-scale experience and carries the canonical
    elevation state as CSS custom properties, which inherit down into the
    atmosphere. It is deliberately not role="img": it contains the range
    control, and image semantics would bury it. The visual description lives
    on the atmosphere field instead.
  -->
  <main
    class="stage"
    data-testid="scene"
    aria-label="The Sun Never Turned Red: an interactive atmospheric explainer"
    style={sceneStyleAttr}
  >
    <div
      class="atmosphere"
      data-testid="atmosphere"
      role="img"
      aria-label="A Sun above a dark horizon. As the Sun moves lower, its light crosses a longer stretch of atmosphere and the light reaching the ground turns warmer."
    >
      <div class="sun-track">
        <div class="sun-bloom"></div>
        <div class="sun-disc"></div>
      </div>
      <div class="path-gauge" aria-hidden="true">
        <div class="path-gauge-fill"></div>
      </div>
      <div class="horizon"></div>
      <div class="observer" aria-hidden="true"></div>
    </div>

    <header class="overlay">
      <nav aria-label="Primary">
        <a href="./">Home</a>
      </nav>
      <h1>The Sun Never Turned Red</h1>
      <p class="instruction" data-testid="instruction">
        Move the Sun toward the horizon.
      </p>
    </header>

    <div class="rail" data-testid="rail">
      <div class="rail-control">
        <label for="elevation">Sun elevation</label>
        <input
          type="range"
          id="elevation"
          name="elevation"
          min={MIN_ELEVATION}
          max={MAX_ELEVATION}
          step="1"
          value={INITIAL_ELEVATION}
        />
      </div>
      <output class="rail-output" for="elevation" id="explanation" aria-live="off"
        >{scene.explanation}</output
      >
      <p class="rail-note" data-testid="model-note">
        Simplified illustration — not a physical simulation.
      </p>
    </div>
  </main>
  <script src="../scripts/main.ts"></script>
</Layout>
